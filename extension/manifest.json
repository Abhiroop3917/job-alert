{
  "manifest_version": 3,
  "name": "Tech Jobs India Alert",
  "version": "1.0.0",
  "description": "Monitors Google, Amazon, Microsoft, Apple, IBM, ServiceNow, Deloitte, and Meta careers and sends desktop notifications for new entry-level jobs in India.",
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": ["https://www.google.com/*", "https://careers.servicenow.com/*", "https://jobs.apple.com/*", "https://southasiacareers.deloitte.com/*", "https://www-api.ibm.com/*", "https://amazon.jobs/*", "https://apply.careers.microsoft.com/*", "https://www.metacareers.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tech Jobs India Alert",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
